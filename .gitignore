# Dependencies
node_modules/
.pi/npm/

# pnpm artifacts (this monorepo uses npm workspaces — root package-lock.json
# is authoritative; subagents occasionally run pnpm in subdirs and these
# stray files get regenerated, so ignore them)
pnpm-lock.yaml
pnpm-workspace.yaml

# Environment
.env
.env.*
!.env.example

# Build output
dist/
build/

# Logs
*.log

# OS
.DS_Store

# Test coverage
coverage/

# Vite cache
.vite/

# Local-only files
*.local

# ESLint cache
.eslintcache

# AI-generated product-management workspace (questions, state, deliverables drafts)
.docs/ai-generated/**
!.docs/ai-generated/**/.gitkeep
