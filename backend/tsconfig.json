{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.backend.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.e2e.test.ts"],
  "references": [
    {
      "path": "./tools/mock-dispatcher"
    }
  ]
}
