{
  "name": "@slykboard/backend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -b tools/mock-dispatcher && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate:core": "drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:agent": "drizzle-kit generate --config=drizzle.config.agent.ts",
    "db:generate": "npm run db:generate:core && npm run db:generate:agent",
    "db:push:core": "drizzle-kit push --config=drizzle.config.ts",
    "db:push:agent": "drizzle-kit push --config=drizzle.config.agent.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio:core": "drizzle-kit studio --config=drizzle.config.ts",
    "db:studio:agent": "drizzle-kit studio --config=drizzle.config.agent.ts",
    "db:seed": "tsx src/db/seed.ts",
    "mock:dispatcher": "tsx tools/mock-dispatcher/index.ts",
    "mock:dispatcher:scenario": "tsx tools/mock-dispatcher/index.ts --scenario"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "isomorphic-dompurify": "^2.0.0",
    "jose": "^6.2.3",
    "nodemailer": "^7.0.13",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
