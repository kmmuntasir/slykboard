# Copy to backend/.env and fill in. NEVER commit real secrets.
# In prod, set via Render env group / docker env_file.

# --- required (app will not start without these) ---
# Comma-separated list = CORS allow-list. Add a tunnel/proxy host when testing
# over HTTPS (e.g. localhost + cloudflared/prod.bd tunnel).
FRONTEND_URL=http://localhost:5173,https://your-tunnel.example.com
# Local docker-compose Postgres (F02). Production uses the hosted pooled URL.
DATABASE_URL=postgresql://slyk:slyk@localhost:5432/slykboard
# F05 — Google SSO + JWT
# Generate with: openssl rand -base64 48 (min 32 chars for HS256)
JWT_SECRET=replace-me-with-a-32-plus-char-random-string
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# D6: 'postmessage' is Google's literal sentinel for the GIS popup auth-code flow.
# NOT a real URL. Do NOT change to http://localhost:... — the GIS library handles redirect internally.
GOOGLE_CALLBACK_URL=postmessage

# --- optional ---
PORT=3000
NODE_ENV=development
TZ=UTC
# F07 D8: JWT time-to-live. jose setExpirationTime string ('8h', '15m', '1d').
# Default '8h' preserves F05/F06 behavior. Shorter = stricter (re-login more often);
# longer = fewer re-logins. The /me endpoint re-signs on every call (sliding window),
# so an active user stays signed in well beyond this TTL.
JWT_TTL=8h
# F06: leave empty to allow all Google accounts; set to your G-Suite domain to restrict.
# Enforcement runs on the Google-verified email at signup. Case-insensitive domain match
# (RFC 5321). Existing users are grandfathered — tightening this does NOT lock out current
# members. Subdomain match is EXACT ('example.com' does NOT match 'sub.example.com').
# Manual email whitelist is F25.
ALLOWED_DOMAIN=

# --- F29 deployment (D4/D8) ---
# Run drizzle migrations automatically on start.
# true in prod (docker-compose / Render); false for local dev (use `make migrate`).
RUN_MIGRATIONS_ON_START=false
# Direct Postgres URL for running migrations. Needed for Supabase/PgBouncer where the
# pooled DATABASE_URL (pooler :6543) cannot run DDL — point at the direct connection (:5432).
# Defaults to DATABASE_URL when unset, so local dev can leave it blank.
DIRECT_DATABASE_URL=

# --- SLYK-01 bootstrap Platform Admin (Task E) ---
# Boot-time, env-driven, idempotent Platform Admin creator. Runs on server start
# (index.ts), NOT during `make bootstrap` (which only runs migrations).
# Empty BOOTSTRAP_ADMIN_EMAIL = bootstrap disabled.
# ALLOWED_DOMAIN, if set, must match the email's domain or the server hard-exits.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# --- SLYK-0130 agent mode (agent-mode-only — leave commented out for plain kanban) ---
# Plain mode boots clean with none of these set. Setting SLYKBOARD_AGENT_MODE=true
# makes URL+token mandatory (server fails fast at boot without them).
# See docs/agentic-automation/02-dual-mode.md for the dual-mode contract.
# SLYKBOARD_AGENT_MODE=false
# SLYKBOARD_DISPATCHER_URL=https://dispatcher.example.com
# HMAC shared secret for dispatcher↔slykboard comms. Generate: openssl rand -hex 32 (min 64 chars).
# SLYKBOARD_DISPATCHER_TOKEN=
# Slack incoming-webhook URL for agent escalations (optional, agent mode only).
# SLYKBOARD_SLACK_ESCALATION_WEBHOOK=

# --- SLYK-0350 outbound email (AGENT_WAITING notifications) ---
# All optional. SLYKBOARD_SMTP_HOST is the switch: unset = no-op transport
# (emails are logged, nothing is sent — the dev/test default). Set it to
# route AGENT_WAITING emails through your SMTP relay.
# SLYKBOARD_SMTP_HOST=smtp.example.com
# SLYKBOARD_SMTP_PORT=587
# SLYKBOARD_SMTP_USER=
# SLYKBOARD_SMTP_PASSWORD=
# SLYKBOARD_SMTP_FROM=noreply@slykboard.local

